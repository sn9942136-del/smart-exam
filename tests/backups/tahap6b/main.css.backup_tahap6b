/* ==============================================================================
   EXAM CBT ROOM SPECIALIZED STYLES
   ============================================================================== */

body.exam-mode {
    background-color: #f1f5f9;
    user-select: none;
    -webkit-user-select: none;
}

.exam-topbar {
