.gap-2\.5 { gap: 0.625rem !important; }
.gap-3\.5 { gap: 0.875rem !important; }

/* Micro-interaction & Hover utilities */
.hover-bg-light {
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.hover-bg-light:hover {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    transform: translateY(-1px);
}

/* Quick Action Card & Text Wrap Utilities */
.quick-action-card {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
}

.overflow-wrap-anywhere {
    overflow-wrap: anywhere;
    word-break: break-word;
    min-width: 0;
    max-width: 100%;
}

/* Navbar Dark Theme Links Readability */
.navbar-dark .navbar-nav .nav-link {
    color: rgba(255, 255, 255, 0.85) !important;
    font-weight: 500;
    transition: color 0.15s ease;
}
.navbar-dark .navbar-nav .nav-link:hover {
    color: #ffffff !important;
}
.navbar-dark .navbar-nav .nav-link.active {
    color: #ffffff !important;
    font-weight: 600;
}

/* Landing Brand & Feature Components */
.brand-icon-box {
    position: relative;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
}
.brand-sub-icon {
    position: absolute;
    bottom: -2px;
    right: -3px;
    font-size: 0.65rem;
}
.portal-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
}
.feature-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
}
.step-number-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
}
.ai-face-box {
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 165, 233, 0.12);
    border: 1.5px solid rgba(56, 189, 248, 0.6);
    border-radius: 50%;
    position: relative;
}
.ai-target-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: #38bdf8;
    border-style: solid;
}
.ai-target-corner.top-left { top: -2px; left: -2px; border-width: 2px 0 0 2px; }
.ai-target-corner.top-right { top: -2px; right: -2px; border-width: 2px 2px 0 0; }
.ai-target-corner.bottom-left { bottom: -2px; left: -2px; border-width: 0 0 2px 2px; }
.ai-target-corner.bottom-right { bottom: -2px; right: -2px; border-width: 0 2px 2px 0; }

.pulse-success {
    background-color: var(--success);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-green 2s infinite;
}
.pulse-danger {
    background-color: var(--danger);
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: pulse-red 2s infinite;
}
@keyframes pulse-green {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}
@keyframes pulse-red {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

/* Normalized Font Size Utilities (Minimum 12px for WCAG Compliance) */
.fs-xs, .fs-sm {
    font-size: 0.8125rem !important; /* 13px */
}

.fs-2xs, .fs-3xs, .fs-4xs, .small {
    font-size: 0.75rem !important;   /* 12px */
}

.fw-semibold {
    font-weight: 600 !important;
}

.fw-bold {
    font-weight: 700 !important;
}

.tracking-tight { letter-spacing: -0.025em; }
.tracking-wide  { letter-spacing: 0.025em; }
.tracking-wider { letter-spacing: 0.05em; }

/* Crisp Elevation & Shadow Utility Classes */
