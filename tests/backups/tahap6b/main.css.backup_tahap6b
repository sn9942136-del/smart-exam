}

.timer-badge-box {
    background: #0f172a;
    color: #38bdf8;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 5px 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
}

.timer-badge-box.timer-warning {
    background: #ea580c;
    color: #ffffff;
}

.timer-badge-box.timer-danger {
    background: #dc2626;
    color: #ffffff;
}

.autosave-badge {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background-color: var(--slate-100);
    color: var(--slate-700);
}

/* Exam Palette Button */
.exam-palette-btn {
    width: 38px;
    height: 38px;
    font-size: 0.8125rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--slate-300);
    background: #ffffff;
    color: var(--slate-700);
    transition: all 0.15s ease;
}

.exam-palette-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.exam-palette-btn.active {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.25);
}

.exam-palette-btn.answered {
    background-color: var(--success);
    border-color: var(--success);
    color: #ffffff;
}

.exam-palette-btn.flagged {
    background-color: var(--warning);
    border-color: var(--warning);
    color: #ffffff;
}

.exam-palette-btn.answered.flagged {
    background: linear-gradient(135deg, var(--success) 50%, var(--warning) 50%);
    border-color: var(--warning);
    color: #ffffff;
}

/* Exam Option Item */
.option-choice-item {
    cursor: pointer;
    border: 1.5px solid var(--border-color);
    border-radius: 10px;
    padding: 12px 16px;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    background-color: #ffffff;
    display: flex;
    align-items: flex-start;
    gap: 12px;
}

.option-choice-item:hover {
    border-color: #a5b4fc;
    background-color: #f8faff;
}

.option-choice-item.selected {
    border-color: var(--primary);
    background-color: var(--primary-light);
}

.option-choice-letter {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background-color: var(--slate-100);
    color: var(--slate-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
}

.option-choice-item.selected .option-choice-letter {
    background-color: var(--primary);
    color: #ffffff;
}

/* ==============================================================================
   ICONOGRAPHY & SPACING HELPERS
   ============================================================================== */

i.bi {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    vertical-align: -0.125em;
}

.icon-box-sm {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.icon-box-md {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.icon-box-lg {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* Animations */
.spin, .animate-spin {
    animation: spin 1s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
}

.pulse-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    animation: pulse-dot 1.5s infinite;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
    width: 5px;
    height: 5px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.4);
    border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(100, 116, 139, 0.6);
}

/* ==============================================================================
   EXAM TAKING INTERFACE (CBT ROOM & TOPBAR)
   ============================================================================== */

body.exam-mode {
    user-select: none;
    -webkit-user-select: none;
    background-color: #f8fafc;
    overflow-x: hidden;
    color: var(--slate-800);
}

/* 1. Exam Topbar */
.exam-topbar {
    height: 58px;
    background: #ffffff;
    border-bottom: 1px solid var(--slate-200);
    position: sticky;
    top: 0;
    z-index: 1030;
}

.timer-badge-box {
    background: #0f172a;
    color: #38bdf8;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    padding: 5px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: var(--shadow-xs);
    transition: all 0.25s ease;
}

.timer-badge-box.timer-warning {
    background: #d97706 !important;
    color: #ffffff !important;
}

.timer-badge-box.timer-danger {
    background: #dc2626 !important;
    color: #ffffff !important;
    animation: pulse-timer 1.2s infinite;
}

@keyframes pulse-timer {
    0% { transform: scale(1); }
    50% { transform: scale(1.03); }
    100% { transform: scale(1); }
}

.autosave-badge {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
}

/* Network Connection States */
.conn-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
}

.conn-online {
    background-color: var(--success-subtle);
    color: #047857;
    border: 1px solid #a7f3d0;
}

.conn-offline {
    background-color: var(--danger-subtle);
    color: #b91c1c;
    border: 1px solid #fecaca;
}

.conn-reconnecting {
    background-color: var(--warning-subtle);
    color: #b45309;
    border: 1px solid #fde68a;
}

.conn-syncing {
    background-color: var(--info-subtle);
    color: #0369a1;
    border: 1px solid #bae6fd;
}

/* 2. Question Card & Typography */
.exam-question-card {
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-xl);
    background-color: #ffffff;
    box-shadow: var(--shadow-xs);
    padding: 24px;
}

.exam-question-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--slate-800);
    margin-bottom: 24px;
    word-break: break-word;
}

/* 3. Answer Choices */
.option-choice-item {
    cursor: pointer;
    border: 1.5px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    transition: all 0.15s ease-in-out;
    background-color: #ffffff;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-height: 48px;
    user-select: none;
    -webkit-user-select: none;
}

.option-choice-item:hover {
    border-color: #a5b4fc;
    background-color: #f8faff;
}

.option-choice-item.selected {
    border-color: var(--primary);
    background-color: #f5f3ff;
    box-shadow: 0 0 0 1px var(--primary);
}

.option-choice-letter {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: var(--radius-md);
    background-color: var(--slate-100);
    color: var(--slate-700);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
    transition: all 0.15s ease;
}

.option-choice-item.selected .option-choice-letter {
    background-color: var(--primary);
    color: #ffffff;
}

.flag-checkbox-label {
    cursor: pointer;
    user-select: none;
}

/* 4. Question Palette Grid */
.exam-palette-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    max-height: 260px;
    overflow-y: auto;
    padding: 2px;
}

.exam-palette-btn {
    width: 100%;
    aspect-ratio: 1 / 1;
    min-height: 36px;
    max-height: 40px;
    font-size: 0.8125rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--slate-200);
    background: #ffffff;
    color: var(--slate-700);
    transition: all 0.15s ease;
    cursor: pointer;
    padding: 0;
}

.exam-palette-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background-color: var(--primary-light);
}

.exam-palette-btn.active {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.35) !important;
    font-weight: 800;
}

.exam-palette-btn.answered {
    background-color: #10b981 !important;
    border-color: #059669 !important;
    color: #ffffff !important;
}

.exam-palette-btn.flagged {
    background-color: #f59e0b !important;
    border-color: #d97706 !important;
    color: #ffffff !important;
}

.exam-palette-btn.answered.flagged {
    background: linear-gradient(135deg, #10b981 50%, #f59e0b 50%) !important;
    border-color: #d97706 !important;
    color: #ffffff !important;
}

/* ==============================================================================
   COMPREHENSIVE RESPONSIVE DESIGN SYSTEM (Desktop, Laptop, Tablet, Mobile)
   ============================================================================== */

/* 1. Global Box Sizing & Fluid Media Containment */
*, *::before, *::after {
    box-sizing: border-box;
}

html, body {
    max-width: 100vw;
    overflow-x: hidden;
}

.app-main-wrapper {
    max-width: 100vw;
    overflow-x: hidden;
}

img, video, canvas, iframe, svg {
    max-width: 100%;
    height: auto;
}

pre, code {
    max-width: 100%;
    word-break: break-word;
}

/* 2. Responsive Table Handling */
.table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--slate-300) transparent;
}

.table-responsive::-webkit-scrollbar {
    height: 6px;
}

.table-responsive::-webkit-scrollbar-thumb {
    background: var(--slate-300);
    border-radius: 4px;
}

.table th, .table td {
    vertical-align: middle;
}

/* 3. Breakpoint: Large Desktop & Desktop (>= 1200px) */
@media (min-width: 1200px) {
    .max-w-1400 {
        max-width: 1400px;
        margin-left: auto;
        margin-right: auto;
    }
}

/* 4. Breakpoint: Laptop & Tablet Landscape (992px to 1199px) */
@media (min-width: 992px) and (max-width: 1199.98px) {
    .app-sidebar {
        width: 240px;
    }
    
    .app-content-body {
        padding: 1.25rem;
    }
}

/* 5. Breakpoint: Tablet Portrait (< 992px) */
@media (max-width: 991.98px) {
    .app-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 1045;
        transform: translateX(-100%);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: none;
    }

    body.sidebar-open .app-sidebar {
        transform: translateX(0);
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.35);
    }

    body.sidebar-open::after {
        content: '';
        position: fixed;
        inset: 0;
        background-color: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(2px);
        z-index: 1040;
    }

    .app-content-body {
        padding: 1rem;
    }

    .card {
        border-radius: var(--radius-lg);
    }
}

/* 6. Breakpoint: Mobile Devices (< 768px) */
@media (max-width: 767.98px) {
    /* Typography Scaling */
    h1, .h1 { font-size: 1.35rem; }
    h2, .h2 { font-size: 1.25rem; }
    h3, .h3 { font-size: 1.15rem; }
    h4, .h4 { font-size: 1rem; }
    h5, .h5 { font-size: 0.9375rem; }
    h6, .h6 { font-size: 0.875rem; }

    .app-topbar {
        padding: 0 0.75rem;
        height: 52px;
        min-height: 52px;
    }

    .app-content-body {
        padding: 0.875rem 0.75rem;
    }

    /* Form & Toolbar Adjustments */
    .form-section-title {
        font-size: 0.8125rem;
        margin-bottom: 0.75rem;
    }

    .btn {
        min-height: 36px;
        font-size: 0.8125rem;
    }

    .btn-xs {
        min-height: 30px;
        font-size: 0.75rem;
    }

    /* Modal Responsive Bounds */
    .modal-dialog {
        margin: 0.5rem;
        max-width: calc(100% - 1rem);
    }

    .modal-header {
        padding: 1rem 1.25rem 0.5rem;
    }

    .modal-body {
        padding: 1rem 1.25rem;
    }

    .modal-footer {
        padding: 0.75rem 1.25rem 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .modal-footer .btn {
        flex: 1 1 auto;
    }

    /* Toast Notification Positioning */
    .toast-container {
        left: 0.5rem !important;
        right: 0.5rem !important;
        bottom: 0.5rem !important;
        max-width: calc(100% - 1rem) !important;
    }

    .toast {
        width: 100% !important;
    }

    /* Dropdown Menus */
    .dropdown-menu {
        max-width: 92vw;
    }

    /* Pagination Wrapping */
    .pagination {
        flex-wrap: wrap;
        justify-content: center;
        gap: 3px;
    }

    .page-item .page-link {
        min-width: 32px;
        height: 32px;
        padding: 0.25rem 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
}

/* 7. Breakpoint: Small Mobile Screens (< 576px) */
@media (max-width: 575.98px) {
    /* Exam Taking Interface Polish */
    .exam-topbar {
        height: 52px;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }

    .exam-question-card {
        padding: 16px;
        border-radius: var(--radius-lg);
    }

    .exam-question-text {
        font-size: 0.9375rem;
        line-height: 1.65;
        margin-bottom: 16px;
    }

    .option-choice-item {
        padding: 10px 12px;
        min-height: 46px;
        gap: 10px;
    }

    .option-choice-letter {
        width: 28px;
        height: 28px;
        min-width: 28px;
        font-size: 0.8125rem;
    }

    .timer-badge-box {
        padding: 4px 10px;
        font-size: 0.8125rem;
        gap: 6px;
    }

    .exam-palette-grid {
        grid-template-columns: repeat(5, 1fr);
        gap: 5px;
        max-height: 200px;
    }

    .exam-palette-btn {
        min-height: 34px;
        font-size: 0.75rem;
    }

    /* KPI Summary Cards on Mobile */
    .card .rounded-circle.p-2\.5 {
        width: 38px !important;
        height: 38px !important;
        padding: 0.4rem !important;
    }
}

/* 8. Touch Screen Optimizations */
@media (hover: none) and (pointer: coarse) {
    .btn, .nav-link, .dropdown-item, .option-choice-item, .page-link {
        touch-action: manipulation;
    }

    .option-choice-item:active {
        background-color: var(--primary-light);
    }
}

