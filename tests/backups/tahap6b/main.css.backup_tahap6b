/* ==============================================================================
   LAYOUT, SIDEBAR & NAVBAR ARCHITECTURE
   ============================================================================== */

.app-sidebar {
    width: var(--vui-sidebar-width, 260px);
    min-height: 100vh;
    height: 100vh;
    position: sticky;
    top: 0;
    z-index: 1040;
    transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    background-color: var(--vui-sidebar-bg, #0f172a);
    border-right: 1px solid var(--vui-sidebar-border, rgba(255, 255, 255, 0.08));
    display: flex;
    flex-direction: column;
}

.sidebar-brand-box {
    height: var(--vui-topbar-height, 64px);
    min-height: var(--vui-topbar-height, 64px);
    max-height: var(--vui-topbar-height, 64px);
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--vui-sidebar-border, rgba(255, 255, 255, 0.08));
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.sidebar-brand-icon {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, var(--vui-primary, #2563eb) 0%, #3b82f6 100%);
    color: #ffffff;
    border-radius: var(--vui-radius, 0.625rem);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.1rem;
    box-shadow: 0 2px 4px rgba(37, 99, 235, 0.25);
}

.sidebar-nav-container {
    flex: 1 1 auto;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1rem 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
}

.sidebar-nav-container::-webkit-scrollbar {
    width: 4px;
}

.sidebar-nav-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
}

/* Sidebar Nav Items */
.app-sidebar .nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.app-sidebar .nav-header {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--vui-sidebar-text, #94a3b8);
    opacity: 0.7;
    font-weight: 700;
    padding: 0.85rem 0.85rem 0.35rem;
    margin-top: 0.5rem;
}

.app-sidebar .nav-header:first-child {
    margin-top: 0;
    padding-top: 0.25rem;
}

.app-sidebar .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 40px;
    height: 40px;
    padding: 0 0.85rem;
    color: var(--vui-sidebar-text, #94a3b8);
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--vui-radius, 0.625rem);
    transition: background-color 0.15s ease, color 0.15s ease;
    text-decoration: none;
    white-space: nowrap;
}

.app-sidebar .nav-link i {
    width: 1.25rem;
    height: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
    color: var(--vui-sidebar-text, #94a3b8);
    transition: color 0.15s ease;
}

.app-sidebar .nav-link:hover {
    background-color: var(--vui-sidebar-hover-bg, rgba(255, 255, 255, 0.06));
    color: var(--vui-sidebar-text-hover, #ffffff) !important;
}

.app-sidebar .nav-link:hover i {
    color: var(--vui-sidebar-text-hover, #ffffff);
}

.app-sidebar .nav-link.active {
    background-color: var(--vui-sidebar-active-bg, rgba(59, 130, 246, 0.16)) !important;
    color: var(--vui-sidebar-active-text, #60a5fa) !important;
    font-weight: 600;
    box-shadow: none !important;
}

.app-sidebar .nav-link.active i {
    color: var(--vui-sidebar-active-text, #60a5fa) !important;
}

/* Sidebar Footer */
.sidebar-footer {
    padding: 0.85rem 1rem;
    background-color: rgba(0, 0, 0, 0.25);
    border-top: 1px solid var(--vui-sidebar-border, rgba(255, 255, 255, 0.08));
}

.sidebar-footer .btn-logout {
    color: var(--vui-sidebar-text, #94a3b8);
    transition: color 0.15s ease, background-color 0.15s ease;
    padding: 0.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--vui-radius-sm, 0.375rem);
    text-decoration: none;
}

.sidebar-footer .btn-logout:hover {
    color: var(--vui-danger, #ef4444);
    background-color: var(--vui-danger-subtle, #fef2f2);
}

.app-main-wrapper {
    min-width: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow-x: hidden;
}

.app-topbar {
    height: var(--vui-topbar-height, 64px);
    min-height: var(--vui-topbar-height, 64px);
    background-color: var(--vui-bg-card, #ffffff);
    border-bottom: 1px solid var(--vui-border, #e2e8f0);
    padding: 0 1.5rem;
    z-index: 1030;
    display: flex;
    align-items: center;
}

#sidebarToggleBtn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--vui-border, #e2e8f0);
    border-radius: var(--vui-radius, 0.625rem);
    background-color: var(--vui-bg-card, #ffffff);
    color: var(--vui-text-body, #334155);
    transition: all 0.15s ease;
}

#sidebarToggleBtn:hover {
    background-color: var(--vui-border-light, #f1f5f9);
    color: var(--vui-text-main, #0f172a);
    border-color: #cbd5e1;
}

.app-content-body {
    background-color: var(--vui-bg-body, #f8fafc);
    padding: 1.5rem;
}

@media (max-width: 768px) {
    .app-content-body {
        padding: 1rem;
    }
    .app-topbar {
        padding: 0 0.875rem;
    }
}

/* Mobile Sidebar Drawer */
@media (max-width: 991.98px) {
    .app-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        transform: translateX(-100%);
    }

    body.sidebar-open .app-sidebar {
        transform: translateX(0);
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.35);
    }

    body.sidebar-open::after {
        content: '';
        position: fixed;
        inset: 0;
        background-color: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(2px);
        z-index: 1035;
    }
}

/* Desktop Collapsed Sidebar */
@media (min-width: 992px) {
    body.sidebar-collapsed .app-sidebar {
        width: 64px;
    }

    body.sidebar-collapsed .sidebar-brand-text,
    body.sidebar-collapsed .sidebar-nav-container span,
    body.sidebar-collapsed .sidebar-nav-container .badge,
    body.sidebar-collapsed .sidebar-nav-container .nav-header,
    body.sidebar-collapsed .sidebar-user-text {
        display: none !important;
    }

    body.sidebar-collapsed .app-sidebar .nav-link {
        justify-content: center;
        padding: 0;
        width: 42px;
        margin: 0 auto;
    }

    body.sidebar-collapsed .app-sidebar .nav-link i {
        font-size: 1.1rem;
        margin: 0;
    }

    body.sidebar-collapsed .sidebar-footer {
        padding: 0.75rem 0;
        display: flex;
        justify-content: center;
    }

    body.sidebar-collapsed .sidebar-footer .sidebar-user-box {
        justify-content: center;
        width: 100%;
    }

    body.sidebar-collapsed .sidebar-footer .btn-logout {
        display: none;
    }
}

/* ==============================================================================
   BUTTONS & ACTIONS
   ============================================================================== */

.btn {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    transition: all 0.15s ease-in-out;
    line-height: 1.4;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn:active {
    transform: translateY(0);
}

.btn-lg {
    font-size: 0.9375rem;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-md);
}

.btn-sm {
    font-size: 0.8125rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
}

.btn-xs {
    font-size: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
}

.btn-primary {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

.btn-primary:hover, .btn-primary:focus {
    background-color: var(--primary-hover);
    border-color: var(--primary-hover);
    color: #ffffff;
}

.btn-primary-gradient {
    background: var(--gradient-primary);
    border: none;
    color: #ffffff;
}

.btn-primary-gradient:hover {
    background: linear-gradient(135deg, #4338ca 0%, #2563eb 100%);
    color: #ffffff;
}

/* ==============================================================================
   FORMS & INPUT CONTROLS
   ============================================================================== */

.form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--slate-800);
    margin-bottom: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
}

.form-label .text-danger, 
.form-label.required::after {
    color: var(--danger);
    content: " *";
    font-weight: 700;
}

.form-control, .form-select {
    font-size: 0.875rem;
    min-height: 38px;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--slate-300);
    color: var(--slate-800);
    background-color: #ffffff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.form-control::placeholder,
.form-select::placeholder,
textarea.form-control::placeholder {
    color: var(--slate-500) !important;
    opacity: 1;
}

textarea.form-control {
    min-height: 80px;
}

.form-control:focus, .form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    outline: none;
}

.form-control:disabled, .form-select:disabled, .form-control[readonly] {
    background-color: var(--slate-100);
    color: var(--slate-600);
    border-color: var(--slate-200);
    cursor: not-allowed;
}

.form-control-sm, .form-select-sm {
    font-size: 0.8125rem;
    min-height: 32px;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
}

.form-control-lg, .form-select-lg {
    font-size: 1rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
}

.input-group-text {
    font-size: 0.875rem;
    min-width: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--slate-100);
    border-color: var(--slate-300);
    color: var(--slate-700);
    padding: 0.45rem 0.75rem;
}

.input-group-text i {
    font-size: 0.95rem;
    line-height: 1;
    color: var(--slate-600);
}

.input-group .form-control:focus ~ .input-group-text {
    border-color: var(--primary);
}

.form-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
    margin-bottom: 0.35rem;
    padding-left: 0;
}

.form-check-input {
    cursor: pointer;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0;
    margin-left: 0;
    flex-shrink: 0;
    border: 1px solid var(--slate-300);
    border-radius: var(--radius-sm);
}

.form-check-input[type="radio"] {
    border-radius: 50%;
}

.form-check-input:checked {
    background-color: var(--primary);
    border-color: var(--primary);
}

.form-check-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
}

.form-check-label {
    font-size: 0.875rem;
    color: var(--slate-700);
    cursor: pointer;
    user-select: none;
}

.form-text {
    font-size: 0.75rem;
    color: var(--slate-600);
    margin-top: 0.3rem;
    line-height: 1.4;
}

.invalid-feedback {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--danger);
    margin-top: 0.3rem;
}

.form-section-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--slate-800);
    padding-bottom: 0.5rem;
    margin-top: 1.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--slate-200);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.form-section-title:first-child {
    margin-top: 0;
}

.form-section-title i {
    font-size: 1rem;
    color: var(--primary);
}

.form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--slate-100);
}

.form-card-container {
    max-width: 680px;
    margin: 0 auto;
}

.form-card-container-lg {
    max-width: 860px;
    margin: 0 auto;
}

.form-card-container-xl {
    max-width: 1040px;
    margin: 0 auto;
}

/* ==============================================================================
   CARDS & CONTAINERS
   ============================================================================== */

.card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
}

.card-header {
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 1.25rem;
}

.card-body {
    padding: 1.25rem;
}

.card-footer {
    background-color: #ffffff;
    border-top: 1px solid var(--border-color);
    padding: 0.875rem 1.25rem;
}

.stat-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.125rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}

/* Portal Role Cards */
.portal-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
}

.portal-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--slate-300);
}

/* Step & Feature Cards */
.step-card, .feature-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
}

.step-card:hover, .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: #93c5fd;
}

/* ==============================================================================
   BUTTONS & ACTION HIERARCHY
   ============================================================================== */

.btn {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    min-height: 38px;
    padding: 0.45rem 0.875rem;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    line-height: 1.4;
    transition: all 0.15s ease;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
}

.btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-xs);
}

.btn:active {
    transform: translateY(0);
}

.btn-primary {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

.btn-primary:hover, .btn-primary:focus {
    background-color: var(--primary-hover) !important;
    border-color: var(--primary-hover) !important;
    color: #ffffff !important;
}

.btn-outline-secondary {
    border-color: var(--slate-300);
    color: var(--slate-700);
    background-color: #ffffff;
}

.btn-outline-secondary:hover {
    background-color: var(--slate-100);
    border-color: var(--slate-400);
    color: var(--slate-900);
}

.btn-outline-danger {
    border-color: #fca5a5;
    color: var(--danger);
    background-color: #ffffff;
}

.btn-outline-danger:hover {
    background-color: var(--danger-subtle);
    border-color: var(--danger);
    color: var(--danger);
}

.btn-outline-success {
    border-color: #86efac;
    color: var(--success);
    background-color: #ffffff;
}

.btn-outline-success:hover {
    background-color: var(--success-subtle);
    border-color: var(--success);
    color: var(--success);
}

.btn-sm {
    font-size: 0.8125rem;
    min-height: 32px;
    height: 32px;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    gap: 0.35rem;
}

.btn-xs {
    font-size: 0.75rem;
    min-height: 26px;
    height: 26px;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    gap: 0.25rem;
}

.btn-lg {
    font-size: 0.9375rem;
    min-height: 44px;
    height: 44px;
    padding: 0.55rem 1.25rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    gap: 0.5rem;
}

.btn-icon-sm {
    width: 32px;
    height: 32px;
    min-height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
}

.btn-icon-xs {
    width: 26px;
    height: 26px;
    min-height: 26px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
}

.btn-group .btn {
    min-height: 32px;
}

/* ==============================================================================
   TABLES
   ============================================================================== */

.table-responsive {
    border-radius: var(--radius-lg);
    scrollbar-width: thin;
}

.table {
    margin-bottom: 0;
    color: var(--slate-700);
    vertical-align: middle;
    border-collapse: separate;
    border-spacing: 0;
}

.table th {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--slate-700);
    background-color: var(--slate-50);
    border-bottom: 1px solid var(--border-color);
    border-top: none;
    padding: 0.75rem 1rem;
    white-space: nowrap;
}

.table td {
    font-size: 0.8125rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color-light);
    border-top: none;
    color: var(--slate-700);
}

.table-hover tbody tr {
    transition: background-color 0.1s ease;
}

.table-hover tbody tr:hover {
    background-color: #f8fafc;
}

.table-hover tbody tr:last-child td {
    border-bottom: none;
}

.table-action-col {
    white-space: nowrap;
    text-align: right;
    width: 1%;
}

/* ==============================================================================
   BADGES & PILLS
   ============================================================================== */

.badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    line-height: 1.3;
    white-space: nowrap;
}

.badge i {
    font-size: 0.85em;
    line-height: 1;
}

.badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
}

.badge.rounded-pill {
    padding-left: 0.65rem;
    padding-right: 0.65rem;
    border-radius: var(--radius-pill);
}

/* Subtle Semantic Badge Classes (High Contrast WCAG AA Standards) */
.bg-primary-subtle {
    background-color: var(--primary-subtle) !important;
    color: #3730a3 !important;
    border-color: #c7d2fe !important;
}

.bg-success-subtle {
    background-color: var(--success-subtle) !important;
    color: #065f46 !important;
    border-color: #a7f3d0 !important;
}

.bg-danger-subtle {
    background-color: var(--danger-subtle) !important;
    color: #991b1b !important;
    border-color: #fecaca !important;
}

.bg-warning-subtle {
    background-color: var(--warning-subtle) !important;
    color: #92400e !important;
    border-color: #fde68a !important;
}

.bg-info-subtle {
    background-color: var(--info-subtle) !important;
    color: #075985 !important;
    border-color: #bae6fd !important;
}

.bg-secondary-subtle {
    background-color: var(--slate-100) !important;
    color: var(--slate-700) !important;
    border-color: var(--slate-200) !important;
}

.bg-dark-subtle {
    background-color: rgba(15, 23, 42, 0.75) !important;
    color: #f8fafc !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
}

/* ==============================================================================
   DROPDOWNS
   ============================================================================== */

.dropdown-menu {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 0.35rem;
    min-width: 170px;
    background-color: #ffffff;
    z-index: 1050;
}

.dropdown-item {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--slate-700);
    font-weight: 500;
    transition: background-color 0.1s ease, color 0.1s ease;
}

.dropdown-item i {
    font-size: 0.95rem;
    color: var(--slate-500);
    transition: color 0.1s ease;
}

.dropdown-item:hover {
    background-color: var(--slate-100);
    color: var(--slate-900);
}

.dropdown-item:hover i {
    color: var(--slate-800);
}

.dropdown-item.text-danger {
    color: var(--danger) !important;
}

.dropdown-item.text-danger i {
    color: var(--danger) !important;
}

.dropdown-item.text-danger:hover {
    background-color: var(--danger-subtle);
    color: #b91c1c !important;
}

.dropdown-divider {
    margin: 0.3rem 0;
    border-top: 1px solid var(--slate-100);
}

/* ==============================================================================
   PAGINATION
   ============================================================================== */

.pagination {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 0;
    padding-left: 0;
    list-style: none;
}

.page-item .page-link {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    min-width: 32px;
    height: 32px;
    padding: 0 0.5rem;
    border-radius: var(--radius-sm) !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--slate-700);
    border: 1px solid var(--slate-200);
    background-color: #ffffff;
    text-decoration: none;
    transition: all 0.15s ease;
}

.page-item .page-link:hover {
    background-color: var(--slate-100);
    color: var(--slate-900);
    border-color: var(--slate-300);
}

.page-item.active .page-link {
    background-color: var(--primary) !important;
    border-color: var(--primary) !important;
    color: #ffffff !important;
    font-weight: 600;
    box-shadow: var(--shadow-xs);
}

.page-item.disabled .page-link {
    color: var(--slate-400);
    background-color: var(--slate-50);
    border-color: var(--slate-200);
    cursor: not-allowed;
    pointer-events: none;
}

/* ==============================================================================
   ALERTS, TOASTS & MODALS
   ============================================================================== */

.alert {
    font-size: 0.8125rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    border-left-width: 3.5px;
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
}

.alert-success {
    background-color: var(--success-subtle);
    border-color: #a7f3d0;
    border-left-color: var(--success);
    color: #065f46;
}

.alert-danger {
    background-color: var(--danger-subtle);
    border-color: #fecaca;
    border-left-color: var(--danger);
    color: #991b1b;
}

.alert-warning {
    background-color: var(--warning-subtle);
    border-color: #fde68a;
    border-left-color: var(--warning);
    color: #92400e;
}

.alert-info {
    background-color: var(--info-subtle);
    border-color: #bae6fd;
    border-left-color: var(--info);
    color: #075985;
}

/* Modals */
.modal-content {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    background-color: #ffffff;
}

.modal-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.modal-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--slate-900);
    font-family: var(--font-heading);
    margin-bottom: 0;
}

.modal-body {
    padding: 1.25rem;
    color: var(--slate-700);
    font-size: 0.875rem;
}

.modal-footer {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--border-color);
    background-color: var(--slate-50);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
}

/* Breadcrumbs */
.breadcrumb {
    font-size: 0.8125rem;
    margin-bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.breadcrumb-item a {
    color: var(--slate-600);
    text-decoration: none;
    transition: color 0.15s ease;
}

.breadcrumb-item a:hover {
    color: var(--primary);
}

.breadcrumb-item.active {
