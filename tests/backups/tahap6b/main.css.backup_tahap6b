/* ==============================================================================
   SISTEM UJIAN ONLINE BERBASIS DUAL KAMERA AI - MINIMAL UNIFIED DESIGN SYSTEM
   ==============================================================================
   Prinsip Desain: Simple, Clean, Professional, Minimal, Consistent, Easy to Scan.
   ============================================================================== */

:root {
    /* 1. Typography Fonts */
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --font-heading: 'Plus Jakarta Sans', var(--font-sans);
    --font-mono: 'JetBrains Mono', 'Consolas', monospace;

    /* 2. Primary & Neutral Color Palette */
    --primary: #4f46e5;
    --primary-hover: #4338ca;
    --primary-light: #eef2ff;
    --primary-subtle: #e0e7ff;
    --primary-focus: rgba(79, 70, 229, 0.15);
    
    --slate-900: #0f172a;
    --slate-800: #1e293b;
    --slate-700: #334155;
    --slate-600: #475569;
    --slate-500: #64748b;
    --slate-400: #94a3b8;
    --slate-300: #cbd5e1;
    --slate-200: #e2e8f0;
    --slate-100: #f1f5f9;
    --slate-50:  #f8fafc;

    /* Semantic Accents (Modern, Clean & WCAG Compliant) */
    --success: #10b981;
    --success-hover: #059669;
    --success-subtle: #ecfdf5;
    --danger: #ef4444;
    --danger-hover: #dc2626;
    --danger-subtle: #fef2f2;
    --warning: #f59e0b;
    --warning-hover: #d97706;
    --warning-subtle: #fffbeb;
    --info: #0284c7;
    --info-hover: #0369a1;
    --info-subtle: #f0f9ff;

    /* 3. Surface & Layout Tokens */
    --surface-body: var(--slate-50);
    --surface-card: #ffffff;
    --border-color: var(--slate-200);
    --border-color-light: var(--slate-100);

    --sidebar-width: 256px;
    --topbar-height: 58px;

    /* 4. Radius Standards */
    --radius-xs: 4px;
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --radius-pill: 9999px;

    /* 5. Minimal Shadow System (Subtle, Crisp Elevation) */
    --shadow-3xs: 0 1px 1px 0 rgba(0, 0, 0, 0.02);
    --shadow-2xs: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
    --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px 0 rgba(0, 0, 0, 0.03);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.07), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
    --shadow-card: var(--shadow-sm);
    --shadow-hover: var(--shadow-md);

    /* Gradients (Soft, Restrained) */
    --gradient-primary: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
    --gradient-admin: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    --gradient-guru: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    --gradient-siswa: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);

    /* ==========================================================================
       6. VUIADMIN ADAPTED DESIGN TOKENS (TAHAP 3 FOUNDATION)
       ========================================================================== */

    /* 6.1 Sidebar & Navigasi */
    --vui-sidebar-bg: #0f172a;
    --vui-sidebar-border: rgba(255, 255, 255, 0.08);
    --vui-sidebar-text: #94a3b8;
    --vui-sidebar-text-hover: #ffffff;
    --vui-sidebar-hover-bg: rgba(255, 255, 255, 0.06);
    --vui-sidebar-active-bg: rgba(59, 130, 246, 0.16);
    --vui-sidebar-active-text: #60a5fa;

    /* 6.2 Konten & Permukaan */
    --vui-bg-body: #f8fafc;
    --vui-bg-card: #ffffff;
    --vui-border: #e2e8f0;
    --vui-border-light: #f1f5f9;

    /* 6.3 Tipografi */
    --vui-text-main: #0f172a;
    --vui-text-body: #334155;
    --vui-text-muted: #64748b;

    /* 6.4 Aksen & Status */
    --vui-primary: #2563eb;
    --vui-primary-subtle: #eff6ff;
    --vui-success: #10b981;
    --vui-success-subtle: #ecfdf5;
    --vui-warning: #f59e0b;
    --vui-warning-subtle: #fffbeb;
    --vui-danger: #ef4444;
    --vui-danger-subtle: #fef2f2;
    --vui-info: #0ea5e9;
    --vui-info-subtle: #f0f9ff;

    /* 6.5 Status CBT DualCamAI */
    --cbt-answered: #10b981;
    --cbt-flagged: #f59e0b;
    --cbt-unanswered: #f1f5f9;
    --cbt-current: #2563eb;

    /* 6.6 Radius & Bayangan */
    --vui-radius-sm: 0.375rem;
    --vui-radius: 0.625rem;
    --vui-card-radius: 1rem;
    --vui-shadow-card: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
    --vui-shadow-hover: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
    --vui-shadow-modal: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);

    /* 6.7 Dimensi Layout */
    --vui-sidebar-width: 260px;
    --vui-topbar-height: 64px;
}

/* ==============================================================================
   VUIADMIN ADAPTED HELPER CLASSES (OPT-IN NEUTRAL UTILITIES)
   ==============================================================================
   Class pembantu ini bersifat modular dan opt-in, tidak menimpa class Bootstrap 
   secara global, dan disiapkan untuk penerapan layout pada tahap berikutnya.
   ============================================================================== */

.vui-card {
    background-color: var(--vui-bg-card);
    border: 1px solid var(--vui-border);
    border-radius: var(--vui-card-radius);
    box-shadow: var(--vui-shadow-card);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.vui-card:hover {
    box-shadow: var(--vui-shadow-hover);
    border-color: rgba(203, 213, 225, 0.8);
}

.vui-icon-wrap {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--vui-radius);
    background-color: var(--vui-primary-subtle);
    color: var(--vui-primary);
    flex-shrink: 0;
    font-size: 1.125rem;
    transition: all 0.2s ease;
}

.vui-icon-wrap.vui-icon-success {
    background-color: var(--vui-success-subtle);
    color: var(--vui-success);
}

.vui-icon-wrap.vui-icon-warning {
    background-color: var(--vui-warning-subtle);
    color: var(--vui-warning);
}

.vui-icon-wrap.vui-icon-danger {
    background-color: var(--vui-danger-subtle);
    color: var(--vui-danger);
}

.vui-icon-wrap.vui-icon-info {
    background-color: var(--vui-info-subtle);
    color: var(--vui-info);
}

.vui-page-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--vui-text-main);
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.25rem;
}

.vui-text-muted {
    color: var(--vui-text-muted) !important;
    font-size: 0.8125rem;
}

.vui-badge-soft {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    border-radius: var(--radius-pill);
    background-color: var(--vui-primary-subtle);
    color: var(--vui-primary);
    border: 1px solid transparent;
}

.vui-badge-soft.vui-badge-success {
    background-color: var(--vui-success-subtle);
    color: var(--vui-success);
    border-color: rgba(16, 185, 129, 0.15);
}

.vui-badge-soft.vui-badge-warning {
    background-color: var(--vui-warning-subtle);
    color: var(--vui-warning);
    border-color: rgba(245, 158, 11, 0.15);
}

.vui-badge-soft.vui-badge-danger {
    background-color: var(--vui-danger-subtle);
    color: var(--vui-danger);
    border-color: rgba(239, 68, 68, 0.15);
}

.vui-badge-soft.vui-badge-info {
    background-color: var(--vui-info-subtle);
    color: var(--vui-info);
    border-color: rgba(14, 165, 233, 0.15);
}

/* ==============================================================================
   BASE & RESET STYLES
   ============================================================================== */

body {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--slate-700);
    background-color: var(--surface-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ==============================================================================
   TYPOGRAPHY HIERARCHY
   ============================================================================== */

h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: var(--font-heading);
    color: var(--slate-900);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.5rem;
}

h1, .h1 { font-size: 1.75rem; letter-spacing: -0.025em; }
h2, .h2 { font-size: 1.5rem; letter-spacing: -0.02em; }
h3, .h3 { font-size: 1.25rem; letter-spacing: -0.015em; }
h4, .h4 { font-size: 1.125rem; font-weight: 600; }
h5, .h5 { font-size: 1rem; font-weight: 600; }
h6, .h6 { font-size: 0.875rem; font-weight: 600; }

p {
    margin-bottom: 0.75rem;
}

.text-muted, .text-secondary {
    color: var(--slate-600) !important;
}

/* Dark Container Muted & Secondary Overrides for Crisp Contrast */
.bg-dark .text-muted,
.bg-dark-gradient .text-muted,
.app-sidebar .text-muted,
.card.bg-dark .text-muted {
    color: rgba(255, 255, 255, 0.75) !important;
}

.bg-dark .text-secondary,
.bg-dark-gradient .text-secondary,
.app-sidebar .text-secondary,
.card.bg-dark .text-secondary {
    color: rgba(255, 255, 255, 0.75) !important;
}

