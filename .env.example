# ==============================================================================
# SISTEM UJIAN ONLINE BERBASIS DUAL KAMERA AI - ENVIRONMENT TEMPLATE
# ==============================================================================
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan konfigurasi server.
# JANGAN PERNAH menyertakan file '.env' yang memuat kredensial asli ke source control!

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Sistem Ujian Online Dual Kamera AI"
# APP_ENV: 'development' untuk lokal/testing, 'production' untuk server rilis
APP_ENV=development
# APP_DEBUG: set 'false' pada lingkungan production untuk keamanan
APP_DEBUG=true
APP_URL=http://localhost/PRD/public
APP_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ujian_dual_kamera
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. SESSION & SECURITY
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
# Masa berlaku sesi dalam detik (7200 = 2 jam)
SESSION_LIFETIME=7200
CSRF_PROTECTION=true

# ------------------------------------------------------------------------------
# 4. STORAGE PATHS (Relatif terhadap root project)
# ------------------------------------------------------------------------------
STORAGE_LOGS=storage/logs
STORAGE_UPLOADS=storage/uploads
STORAGE_RECORDINGS=storage/recordings

# ------------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Masukkan API Key Gemini yang valid (Kosongkan pada template publik)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 6. NOTIFICATION & EMAIL SMTP CONFIGURATION (GMAIL)
# ------------------------------------------------------------------------------
# Mode pengiriman notifikasi:
# - 'simulation' : Mode default (aman, in-memory, tanpa koneksi eksternal)
# - 'sandbox'    : Mode pengujian terisolasi (mock lokal atau pengujian terkontrol)
NOTIFICATION_MODE=simulation

# Konfigurasi SMTP Gmail (Port 587 STARTTLS)
# PENTING: Gunakan 16 karakter App Password dari Akun Google Anda,
# BUKAN password login akun Google biasa.
# Panduan pembuatan App Password: Akun Google > Keamanan > Verifikasi 2 Langkah > Sandi Aplikasi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Smart Exam"

# Pembatasan alamat penerima untuk testing/sandbox (Opsional tapi direkomendasikan saat pengujian)
# Selama pengujian, email hanya akan dikirimkan jika alamat penerima sama persis dengan variabel ini.
# Contoh: NOTIFICATION_TEST_RECIPIENT=guru.penguji@gmail.com
NOTIFICATION_TEST_RECIPIENT=

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & WHATSAPP GATEWAY CONFIGURATION (FONNTE API)
# ------------------------------------------------------------------------------
# Konfigurasi Fonnte WhatsApp API (https://fonnte.com):
# Masukkan API Token yang didapatkan dari dashboard Fonnte Anda.
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=
NOTIFICATION_TEST_PHONE=

